        "1",
        1
      ]
    },
    "_meta": {
      "title": "正向：只写发型结构"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "long hair, curly hair, wet look, bald, helmet hair, bowl cut, flat hair, cartoon, plastic, blurry, text, watermark, hat, headband, changed face",
      "clip": [
        "1",
        1
      ]
    },
    "_meta": {
      "title": "负向：禁止换脸与旧发型"
