eps","type":"INT","widget":{"name":"resolution_steps"},"link":null}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[2,13]}],"title":"保持照片比例 / 约100万像素","properties":{"Node name for S&R":"ImageScaleToTotalPixels"},"widgets_values":["lanczos",1,8],"widgets_values_named":{"upscale_method":"lanczos","megapixels":1,"resolution_steps":8}},{"id":10,"type":"VAEEncode","pos":[784.9673705844732,549.3454868333635],"size":[320,220],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"像素","name":"pixels","type":"IMAGE","link":2},{"localized_name":"vae","name":"vae","type":"VAE","link":3}],"outputs":[{"localized_name":"Latent","name":"LATENT","type":"LATENT","links":[4]}],"title":"参考图编码","properties":{"Node name for S&R":"VAEEncode"}},{"id":11,"type":"MarkdownNote","pos":[30,-550],"size":[950,500],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[],"title":"先读这里 / 使用说明与效果边界","properties":{},"widgets_values":["# 我的人物形象图 / SDXL 图生图\n\n① 在左侧「上传你的人物照片」选择自己的照片（必须先上传，默认文件名只是提示）。\n② 修改绿色正向提示词：保留人物描述，调整衣服、背景、光线或风格。\n③ 点击运行。默认约100万像素、保持照片比例、28步、CFG 5、denoise 0.28、固定种子42。\n\ndenoise 建议起点：0.15～0.25轻微润色；0.25～0.35尝试形象照；0.40以上变化更明显，脸也更容易改变。\n先固定种子比较参数，满意后可改种子挑选不同结果。\n\n这是基础图生图，不含 FaceID、InstantID 或人物LoRA，不能保证身份一致；低重绘也不保证完全保留五官。适合同构图的小幅调整，不适合从半身照强行变全身/多视角角色。\n人物真实效果须用你的照片验证。所有生成在本地完成，不调用付费API。\n输出：output/Persona/SDXL。左下预览为送入模型的参考图，右侧为结果。\n"],"widgets_values_named":{"text":"# 我的人物形象图 / SDXL 图生图\n\n① 在左侧「上传你的人物照片」选择自己的照片（必须先上传，默认文件名只是提示）。\n② 修改绿色正向提示词：保留人物描述，调整衣服、背景、光线或风格。\n③ 点击运行。默认约100万像素、保持照片比例、28步、CFG 5、denoise 0.28、固定种子42。\n\ndenoise 建议起点：0.15～0.25轻微润色；0.25～0.35尝试形象照；0.40以上变化更明显，脸也更容易改变。\n先固定种子比较参数，满意后可改种子挑选不同结果。\n\n这是基础图生图，不含 FaceID、InstantID 或人物LoRA，不能保证身份一致；低重绘也不保证完全保留五官。适合同构图的小幅调整，不适合从半身照强行变全身/多视角角色。\n人物真实效果须用你的照片验证。所有生成在本地完成，不调用付费API。\n输出：output/Persona/SDXL。左下预览为送入模型的参考图，右侧为结果。\n"},"color":"#432","bgcolor":"#653"},{"id":12,"type":"PreviewImage","pos":[1523.7367496800819,704.5021593950202],"size":[420,480],"flags":{},"order":7,"mode":0,"inputs":[{"localized_name":"图像","name":"images","type":"IMAGE","link":13}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"参考图预览 / 实际输入尺寸","properties":{"Node name for S&R":"PreviewImage"}}],"links":[[1,8,0,9,0,"IMAGE"],[2,9,0,10,0,"IMAGE"],[3,1,2,10,1,"VAE"],[4,10,0,5,3,"LATENT"],[5,1,1,2,0,"CLIP"],[6,1,1,3,0,"CLIP"],[7,1,0,5,0,"MODEL"],[8,2,0,5,1,"CONDITIONING"],[9,3,0,5,2,"CONDITIONING"],[10,5,0,6,0,"LATENT"],[11,1,2,6,1,"VAE"],[12,6,0,7,0,"IMAGE"],[13,9,0,12,0,"IMAGE"]],"groups":[],"config":{},"extra":{"ds":{"scale":1.8987491679162145,"offset":[-479.4879018226003,34.568387771459015]}},"version":0.4}